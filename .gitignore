# --- Regenerable data & outputs ---
# Raw dataset is kept (documented in README); derived/processed artifacts
# and large result files are regenerated by running the notebook or
# train.py, so they are not tracked in git.
data/processed/
outputs/results/predictions.csv

# --- Streamlit / trained model artifacts ---
# Serialized model parameters produced by train.py are regenerable and
# excluded to keep the repo lean; run `python train.py` to recreate them.
models/*.npy
models/*.pkl
